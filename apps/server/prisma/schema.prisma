// Prisma schema for the Loup-Garou companion app.
//
// Design note: the GameEngine (packages/game-engine) keeps the live,
// in-memory authoritative state for every active game — that's what the
// server actually plays against, and it's what makes the engine fast and
// simple to unit test. Postgres exists for three things: (1) surviving a
// server restart by persisting a snapshot of each active game, (2) admin
// presets, and (3) a durable history of finished games + logs for stats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A permanent player account (Phase 1 of the "comptes / profils / stats"
// spec). This is the identity that stats, history and (later) rating are
// always attached to — NEVER the per-game nickname on PlayerRecord, which
// stays purely cosmetic and disposable. See PlayerRecord.userId.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  // Shown on the profile/leaderboards; distinct from `username` (the login
  // handle) so it can be changed more freely later without breaking logins.
  // Defaults to `username` at signup.
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 2b — cahier de charge sections 6/10 (rating + specialized
  // ratings). All start at 1000 (section 6's stated initial value) and are
  // updated by apps/server/src/rating/applyRating.ts using
  // packages/rating's pure computeRatingDelta(); exactly one of the three
  // specialized fields updates alongside ratingGlobal for any given game,
  // depending on which team the player was on that game (see
  // packages/rating's specializedScopeForTeam()).
  ratingGlobal  Float @default(1000)
  ratingVillage Float @default(1000)
  ratingWolf    Float @default(1000)
  ratingSolo    Float @default(1000)

  // Phase 3 — cahier de charge sections 11/12 (XP/niveau + MVP). Independent
  // of rating (the spec says so explicitly) — see
  // apps/server/src/progression/deriveProgression.ts for the pure XP/level
  // math and applyProgression.ts for how these get updated.
  totalXp  Int @default(0)
  level    Int @default(1)
  mvpCount Int @default(0)

  playerRecords PlayerRecord[]
  // Cahier de charge #2 §17.4c (Badges).
  badges        UserBadge[]
}

// Which badges a user has unlocked, and when — cahier de charge #2 §17.4c.
// Deliberately just this: badge METADATA (name, description, secret flag,
// unlock condition) lives in code, in
// apps/server/src/badges/deriveBadges.ts's BADGE_REGISTRY, the same
// "registry, not DB rows" pattern already proven for PERFORMANCE_SCORERS
// and ROLE_REGISTRY (see FEATURES.md section 16) — adding a brand new
// badge is one array entry + a redeploy, never a migration. `badgeId` is
// therefore a free-form string, not a foreign key to a badge table that
// doesn't exist.
model UserBadge {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// Runtime-tunable per-role difficulty coefficients (section 7). Seeded from
// packages/rating's DEFAULT_ROLE_DIFFICULTY the first time a role is rated
// (see applyRating.ts) - a row here always wins over the code default, so
// retuning a coefficient is a data change, never a deploy. A role with no
// row yet (brand new role, or nobody's configured it) simply uses the code
// default/neutral fallback - see packages/rating's getRoleDifficulty().
model RoleDifficulty {
  roleId      String   @id
  coefficient Float
  updatedAt   DateTime @updatedAt
}

model Game {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  phase       String
  configJson  Json
  stateJson   Json // full serialized GameEngine internal state (Maps -> arrays)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  endedAt     DateTime?
  winner      String? // "VILLAGE" | "LOUPS" | null
  // Snapshot of GameStatePublic.nightNumber/dayNumber at the moment the game
  // reached ENDED (see persistGame in db/persistence.ts). Lets the stats
  // layer express "nights survived" for every player without the account
  // layer needing to reach into the engine's internal state itself - stays
  // 0 for a game still in progress or one that ended before this field
  // existed (old rows just report 0 nights/days survived, which only
  // affects the "average nights survived" stat, never games/wins/losses).
  finalNightNumber Int @default(0)
  finalDayNumber   Int @default(0)

  logs    GameLogEntry[]
  players PlayerRecord[]

  @@index([code])
}

model PlayerRecord {
  id           String   @id @default(uuid())
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId       String
  // GameEngine's own player id (InternalPlayer.id) — distinct from this
  // row's own `id` PK. Lets finalizeGameHistory() upsert idempotently
  // instead of risking duplicate rows if it's ever invoked twice for the
  // same game.
  enginePlayerId String
  // The temporary per-game pseudo (section 2 of the spec) — cosmetic only,
  // never used for stats/rating/history lookups. Those all key off `userId`.
  nickname     String
  roleId       String
  isAlive      Boolean  @default(true)
  isChef       Boolean  @default(false)
  deathCause   String?
  // Human-readable "Nuit N" / "Jour N" moment of death, or null if he
  // survived to the end.
  deathMoment  String?
  // This player's team AT THE END of the game (a role like Mowgli can
  // change team mid-game) — see ROLE_METADATA / GameEngine.getFinalPlayerSummaries().
  team         String?
  // "WON" | "LOST" | "DRAW" | null while the game is still in progress.
  // Computed once, at game end, from team vs. Game.winner.
  result       String?
  // The GLOBAL rating delta this game produced for this player (null if the
  // player wasn't account-linked, or rating hasn't been applied yet) - see
  // applyRating.ts. Purely informational today (surfaced on history later);
  // the authoritative current rating always lives on User, never derived
  // by summing these.
  ratingDelta  Float?
  // Phase 3 (sections 11/12) — total XP this game actually awarded this
  // player (participation + victory + MVP bonus, whichever applied),
  // purely informational like ratingDelta above. isMvp is set once the
  // post-game MVP vote finalizes for this game (see
  // apps/server/src/mvp/*) - true for every tied winner, not just one.
  xpEarned     Int     @default(0)
  isMvp        Boolean @default(false)
  joinedAt     DateTime @default(now())

  // Cahier de charge #2 §17.4c — this ONE game's contribution to this
  // player's career badge totals, computed once at finalizeGameHistory()
  // time from GameEngine.getPlayerEvents()/getEventLog() (see
  // apps/server/src/badges/deriveBadgeContribution.ts, a pure function unit
  // tested without a database). apps/server/src/badges/applyBadges.ts SUMs
  // these across a user's whole PlayerRecord history to evaluate the
  // role-mastery badges — a per-game fact, cheap to SUM(), same reasoning
  // as ratingDelta/xpEarned above never needing the full engine state
  // replayed to answer "how well has this account done overall".
  voyanteWolvesFound           Int     @default(0)
  salvateurSuccessfulProtects  Int     @default(0)
  sorciereWolvesKilledByPoison Int     @default(0)
  chasseurWolvesKilledByShot   Int     @default(0)
  alienCorrectGuesses          Int     @default(0)
  loupVertSuccessfulSteals     Int     @default(0)
  corbeauSuccessfulMarks       Int     @default(0)
  barbieWolvesRevealed         Int     @default(0)
  barbieMisfires               Int     @default(0)
  mowgliTransformed            Boolean @default(false)
  // True only for the sole surviving member of the WINNING team this game —
  // see deriveBadgeContribution.ts's wasSoleSurvivor().
  wasSoleSurvivor              Boolean @default(false)

  // Nullable: a handful of legacy PlayerRecord rows (written before accounts
  // existed) or a guest who somehow bypassed the join-gate can have no
  // account attached — they just never show up in anyone's stats/history.
  // onDelete: SetNull so deleting an account doesn't blow away the
  // historical game record for the other players who WERE in that game.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@unique([gameId, enginePlayerId])
  @@index([gameId])
  @@index([userId])
}

model GameLogEntry {
  id        String   @id @default(uuid())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  dayOrNight String
  message   String
  timestamp DateTime @default(now())

  @@index([gameId])
}

model Preset {
  id        String   @id @default(uuid())
  name      String   @unique
  configJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
