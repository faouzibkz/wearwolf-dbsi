# --- Database ---
DATABASE_URL="postgresql://loupgarou:loupgarou@localhost:5432/loupgarou?schema=public"

# --- Server ---
SERVER_PORT=4000
# Comma-separated list of allowed origins. Playing with remote friends over
# a tunnel (Tailscale Funnel, etc.)? Add its public URL here alongside
# localhost -- see TAILSCALE_SETUP.md for the full walkthrough.
CORS_ORIGIN="http://localhost:3000"

# --- Web ---
# Local `docker compose up`: leave this pointing at the proxy (port 3000),
# not the server directly -- see proxy/nginx.conf. Playing with remote
# friends over a tunnel? Set this to the SAME public URL as the tunnel
# itself, no separate port -- see TAILSCALE_SETUP.md.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
